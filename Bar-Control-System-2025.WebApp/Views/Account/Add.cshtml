@{
    ViewBag.Title = "Add Table";
}

@model AddTableViewModel;

<div class="row justify-content-center">
    <form class="col-6" method="post" asp-action="Add">   
        <div class="mb-3">
                <label asp-for="TableNumber" class="form-label">Table Number</label>
                <input class="form-control" asp-for="TableNumber">
                <span asp-validation-for="TableNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
                <label asp-for="TableSize" class="form-label">Table Size</label>
                <input class="form-control" asp-for="TableSize">
                <span asp-validation-for="TableSize" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-outline-primary px-4 ms-">Back</a>
            <button class="btn btn-primary px-4">Save</button>
        </div>
    </form>
</div>

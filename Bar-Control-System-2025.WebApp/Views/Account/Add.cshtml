@{
    ViewBag.Title = "Add Order";
}

@model OpenAccountViewModel;

@{
    ViewBag.Titulo = "Account Opening";
}

<div class="row justify-content-center my-5">
    <div class="col-md-8">
        <div class="card rounded-4 border-0">
            <div class="card-body p-md-5">
                <form asp-action="Abrir" method="post">
                    <h3>For for open an account</h3>

                    <div class="form-group d-grid gap-2 mt-3">
                        <label asp-for="Customer" class="control-label fs-5">Customer:</label>
                        <input asp-for="Customer" class="form-control" />
                        <span asp-validation-for="Customer" class="text-danger"></span>
                    </div>
                    <div class="form-group d-grid gap-2 mt-3">
                        <label asp-for="TableId" class="control-label fs-5">Table:</label>
                        <select asp-for="TableId" asp-items="@Model.AvailableTables" class="form-select"></select>
                        <span asp-validation-for="TableId" class="text-danger"></span>
                    </div>
                    <div class="form-group d-grid gap-2 mt-3">
                        <label asp-for="WaiterId" class="control-label fs-5">Waiter:</label>
                        <select asp-for="WaiterId" asp-items="@Model.AvailableWaiters" class="form-select"></select>
                        <span asp-validation-for="WaiterId" class="text-danger"></span>
                    </div>
                    <div class="form-group d-flex align-items-center justify-content-end gap-3 mt-5">
                        <a asp-action="Index">Back to the list</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-5">Confirm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
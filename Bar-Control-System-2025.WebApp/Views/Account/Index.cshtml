
@{
    ViewBag.Title = "Account Viewer";
}

@model ViewAccountViewModel;

<a class="btn btn-primary" asp-action="Open">
    <i class="bi bi-plus"></i>
    Open new
</a>

<div class="row mt-4">
    @foreach (DetailAccountViewModel a in Model.Registers)
    {
        <div class="col-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@a.Customer</h5>
                    <p class="card-text mb-0"><strong>Table:</strong> #@a.Table</p>
                    <p class="card-text mb-0"><strong>Waiter:</strong> @a.Waiter</p>

                    @if (a.StillOpen)
                    {
                        <span class="d-flex gap-1 justify-content-end mt-4">
                            <a title="Manage Orders" asp-action="ManagerOrders" asp-route-id="@a.Id" style="height: 35px; width: 35px;" class="btn btn-primary rounded-circle d-flex justify-content-center align-items-center">
                                <i class="bi bi-cart"></i>
                            </a>
                            <a title="Close Account" asp-action="Close" asp-route-id="@a.Id" style="height: 35px; width: 35px;" class="btn btn-success rounded-circle d-flex justify-content-center align-items-center">
                                <i class="bi bi-cash-coin"></i>
                            </a>
                        </span>
                    }
                </div>
            </div>
        </div>
    }
</div>
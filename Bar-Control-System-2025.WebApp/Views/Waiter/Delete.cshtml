@{
    ViewBag.Title = "Waiter Viewer";
}

@model DeleteWaiterViewModel;

<div class="row justify-content-center">
    <form class="col-6" method="post" asp-action="Delete">
        <p>Do you want to delete the Waiter @Model.Name?</p>

        <input type="hidden" asp-for="Name" />
        
        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-outline-primary px-4 ms-">Back</a>

            <button type="submit" class="btn btn-danger px-4">Delete</button>
        </div>
    </form>
</div>
@{
    ViewBag.Title = "Waiter Viewer";
}

@model EditWaiterViewModel;

<div class="row justify-content-center">
    <form class="col-6" method="post" asp-action="Edit">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name</label>
            <input class="form-control" asp-for="Name">
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SSN" class="form-label">SSN</label>
            <input class="form-control" asp-for="SSN">
            <span asp-validation-for="SSN" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <a asp-action="Index" class="btn btn-outline-primary px-4 ms-">Back</a>
            <button class="btn btn-primary px-4">Save</button>
        </div>
    </form>
</div>

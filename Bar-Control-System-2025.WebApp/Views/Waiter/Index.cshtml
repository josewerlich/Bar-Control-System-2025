
@{
    ViewBag.Title = "Waiter Viewer";
}

@model WaiterViewModels;

<a class="btn btn-primary" href="/Waiter/Add">
    <i class="bi bi-plus"></i>
    Add Waiter
</a>

<div class="row mt-4">
    @foreach (DetailWaiterViewModel w in Model.Register)
    {
        <div class="col-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">#@w.Name</h5>

                    <p class="card-text"><strong>Name:</strong> @w.Name</p>

                </div>

                <div class="card-actions ms-auto me-3 mb-3 d-flex gap-1">
                    <a class="btn btn-sm btn-primary rounded d-flex justify-content-center align-items-center" style="height: 35px; width: 35px;" href="/Waiter/Edit/@w.Id">
                        <i class="bi bi-pen"></i>
                    </a>
                    <a class="btn btn-sm btn-danger rounded d-flex justify-content-center align-items-center" style="height: 35px; width: 35px;" href="/Waiter/Delete/@w.Id">
                        <i class="bi bi-trash"></i>
                    </a>
                </div>
            </div>
        </div>
    }
</div>